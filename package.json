{
	"name": "emw-lib",
	"private": true,
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eddow/emw-lib.git"
	},
	"packageManager": "pnpm@11.25.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./cli": {
			"types": "./src/lib/cli.ts",
			"default": "./src/lib/cli.ts"
		},
		"./alfred-server": {
			"types": "./src/lib/alfred/server.ts",
			"default": "./src/lib/alfred/server.ts"
		},
		"./alfred/client": {
			"types": "./src/lib/alfred/client.ts",
			"default": "./src/lib/alfred/client.ts"
		},
		"./alfred/tools": {
			"types": "./src/lib/alfred/tools.ts",
			"default": "./src/lib/alfred/tools.ts"
		},
		"./alfred/ask-human": {
			"types": "./src/lib/alfred/ask-human.ts",
			"default": "./src/lib/alfred/ask-human.ts"
		},
		"./alfred/types": {
			"types": "./src/lib/alfred/types.ts",
			"default": "./src/lib/alfred/types.ts"
		},
		"./auth-server": {
			"types": "./src/lib/auth/server.ts",
			"default": "./src/lib/auth/server.ts"
		},
		"./db-server": {
			"types": "./src/lib/db/server.ts",
			"default": "./src/lib/db/engine.js"
		},
		"./sentry": {
			"types": "./src/lib/sentry/index.ts",
			"default": "./src/lib/sentry/index.ts"
		},
		"./sentry-server": {
			"types": "./src/lib/sentry/server.ts",
			"default": "./src/lib/sentry/engine.js"
		},
		"./workflows-server": {
			"types": "./src/lib/workflows/server.ts",
			"default": "./src/lib/workflows/server.ts"
		},
		"./theme.css": "./src/lib/theme.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"tsc": "tsc",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"biome:format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@inlang/paraglide-js": "^2.18.2",
		"@types/node": "^22.20.2",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@sentry/sveltekit": "^11.1.0",
		"better-auth": "^1.7.6",
		"is-interactive": "^2.0.0"
	},
	"peerDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@inquirer/prompts": "^7.2.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0"
	}
}
